# ==========================================================
# Visitor Geo Intelligence
# ==========================================================
#
# Do not commit real secrets.
#
# Netlify server-side environment variables:
#
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Current Supabase secret key:
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Legacy fallback, only when your project still uses legacy keys:
SUPABASE_SERVICE_ROLE_KEY=

# Optional request authentication secret used between
# the website and the server-side analytics ingest endpoint.
VGI_INGEST_SECRET=replace-with-a-long-random-secret

# Dashboard access will be configured in a later phase.
VGI_DASHBOARD_ALLOWED_EMAILS=

# Company Detection
# Provider endpoint must return the normalized JSON fields documented in
# supabase/functions/analytics-ingest/company-detection.ts.
COMPANY_LOOKUP_PROVIDER=custom
COMPANY_LOOKUP_URL=
COMPANY_LOOKUP_API_KEY=
COMPANY_LOOKUP_HASH_SECRET=replace-with-a-long-random-secret

# Visitor alert delivery
VISITOR_ALERT_WEBHOOK_URL=
VISITOR_ALERT_JOB_TOKEN=replace-with-long-random-token
